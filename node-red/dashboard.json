    {
        "id": "57cce63583f9738a",
        "type": "function",
        "z": "84942d5dd80504a4",
        "name": "Formato estado LED",
        "func": "// Recibe la CONFIRMACION del ESP32 (actuador/led/estado) y la convierte\n// en un texto legible para el dashboard.\nconst estado = String(msg.payload).trim().toUpperCase();\nif (estado === \"ON\") {\n    msg.payload = \"🟢 ENCENDIDO\";\n} else if (estado === \"OFF\") {\n    msg.payload = \"⚫ APAGADO\";\n} else {\n    node.warn(\"Estado de LED desconocido: \" + msg.payload);\n    return null;\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 420,
        "wires": [
            [
                "cca8edbd59ae8b40"
            ]
        ]
    },
