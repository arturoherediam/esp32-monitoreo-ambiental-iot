    {
        "id": "60287592425d9ed9",
        "type": "function",
        "z": "84942d5dd80504a4",
        "name": "Formato estado ESP32",
        "func": "// esp32/status: \"online\" lo publica el ESP32 al conectarse;\n// \"offline\" lo publica el broker automaticamente (LWT) si el ESP32 se desconecta.\nconst estado = String(msg.payload).trim().toLowerCase();\nif (estado === \"online\") {\n    return [{ payload: \"🟢 En línea\" }, { payload: \"✅ ESP32 conectado\" }];\n}\nif (estado === \"offline\") {\n    // Salida 1: texto de estado. Salida 2: notificacion emergente.\n    return [{ payload: \"🔴 Desconectado\" }, { payload: \"⚠️ ESP32 desconectado: los valores mostrados ya no se actualizan\" }];\n}\nnode.warn(\"Estado de ESP32 desconocido: \" + msg.payload);\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 560,
        "wires": [
            [
                "ac19999993e7b8a1"
            ],
            [
                "406e362a886f71f7"
            ]
        ]
    },
